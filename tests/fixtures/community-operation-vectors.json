{
  "algorithms": {
    "canonicalization": "RFC 8785 JSON Canonicalization Scheme (npm package canonicalize)",
    "communityId": "base64url(sha256(utf8(canonicalize({networkId, nonce, ownerIdentityId}))))",
    "deviceCredential": "mutation.author.deviceCredential is the PEM-less base64 public key of the signing device, here the identity's own key acting as its first device, so it equals identityId and the same key signs",
    "digest": "base64url(sha256(utf8(canonicalize(payload without id)))), also the value other operations list in parents",
    "inviteToken": "base64url(sha256(utf8(JSON.stringify([communityId, creatorIdentityId, nonce])))), only used as the member_joined reference of an invite_link",
    "payloadDigest": "base64url(sha256(utf8(canonicalize(payload))))",
    "recordId": "community:<communityId>:op:<digest>",
    "signature": "ed25519 over utf8(signingContent), standard base64 with padding (88 characters)",
    "signingContent": "\"pigeon:public-mutation:v2\\n\" + canonicalize(mutationBody), mutationBody being the mutation without its signature"
  },
