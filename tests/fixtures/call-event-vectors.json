{
  "algorithms": {
    "callId": "uuid built from the first 16 bytes of sha256(utf8(creatorIdentityId + \":\" + nonce)); byte 6 = (byte6 % 16) + 128, byte 8 = (byte8 % 64) + 128; lowercase hex as 8-4-4-4-12. nonce matches ^[A-Za-z0-9_-]{16,128}$",
    "canonicalization": "RFC 8785 JSON Canonicalization Scheme (npm package canonicalize)",
    "deviceCredential": "mutation.author.deviceCredential is the base64 SPKI public key of the signing device, here the identity key acting as its first device",
    "participantRecordId": "\"call-participant:\" + callId + \":\" + identityId; one record per call and identity, later states carry sequence + 1 and predecessor",
    "payloadDigest": "base64url(sha256(utf8(canonicalize(payload))))",
    "predecessor": "null for sequence 0; otherwise payloadDigest-style digest base64url(sha256(utf8(canonicalize(previous complete mutation including signature))))",
    "recordIds": "\"call:\" + callId (start), \"call-participant:\" + callId + \":\" + identityId, \"call-end:\" + callId",
    "signature": "ed25519 over utf8(signingContent), standard base64 with padding (88 characters)",
    "signingContent": "\"pigeon:public-mutation:v2\\n\" + canonicalize(mutationBody), mutationBody being the mutation without its signature"
  },
