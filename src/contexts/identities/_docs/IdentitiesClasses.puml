@startuml

title Pigeon Swarm - Identities Context

package "identities.domain" {
  class Identity <<AggregateRoot>> {
    -id: IdentityId
    -deviceCredential: DeviceCredential
    -deviceCredentialCommitment: DeviceCredentialCommitment
    -recoveryAuthority: RecoveryAuthority
    -authorizationRevision: IdentityAuthorizationRevision
    -networks: UniqueObjectArray<NetworkId>
    -profile: Profile
    -publication: IdentityPublication
    +fromSignedPublication(primitives): Identity
    +hasValidAdmissionProof(difficulty = floor): boolean
    +isFreshAdmissionAt(now): boolean
    +networksAddedSince(previous: Identity): NetworkId[]
  }

  class Profile {
    -name: ProfileName
    -handle?: ProfileHandle
    -biography?: ProfileBiography
    -picture?: ProfileImage
    -banner?: ProfileBanner
  }

  class ProfileName <<ValueObject>>
  class ProfileHandle <<ValueObject>>
  class ProfileBiography <<ValueObject>>
  class ProfileImage <<ValueObject>>
  class ProfileBanner <<ValueObject>>
  class IdentityExternalIdentifier <<ValueObject>>
  class DeviceCredential <<ValueObject>>
  class DeviceCredentialCommitment <<ValueObject>>
  class RecoveryAuthority <<ValueObject>>
  class IdentityAuthorizationRevision <<ValueObject>>

  class IdentityAdmissionDifficulty <<ValueObject>> {
    +FREE_ADMISSIONS_PER_WINDOW = 60
    +MAX_BITS = 20
    +FRESHNESS_HORIZON_MS = 10 min
    +floor(): IdentityAdmissionDifficulty
    +max(): IdentityAdmissionDifficulty
    +forRecentAdmissions(count): IdentityAdmissionDifficulty
    +isFreshAdmission(signedAt, now): boolean
    +hardest(other): IdentityAdmissionDifficulty
  }

  note right of IdentityAdmissionDifficulty
    API policy only: floor 16 bits,
    +1 bit per doubling above 60 admissions
    per network per window (local plus
    observed), max 20; max when signed
    outside the freshness horizon.
    Replicated records stay valid at 16.
  end note

  class IdentityCandidate {
    -externalIdentifier: IdentityExternalIdentifier
    -identity: Identity
    +getExternalIdentifier(): IdentityExternalIdentifier
    +getIdentity(): Identity
    +isIdentifiedBy(identityId): boolean
    +isNewerThan(other): boolean
  }

  note right of ProfileHandle
    Stored lowercase without @.
    Allowed characters: letters,
    numbers, dots, hyphens and underscores.
  end note

  note right of ProfileImage
    Public IPFS CID for profile image/avatar.
    Base64/data URLs are not stored here.
  end note

  note right of ProfileBanner
    Public IPFS CID for profile banner.
    Base64/data URLs are not stored here.
  end note

  class IdentitySignatureDomainService {
    +isValidSignature(deviceCredential, payload, signature): boolean
  }

  class IdentityResolutionDomainService {
    +validate(identity: Identity): void
    +chooseCurrent(candidates: Identity[]): Identity
  }

  interface IdentityRepository {
    +save(identity: Identity): Promise<IdentityExternalIdentifier>
    +findById(id: IdentityId): Promise<Identity>
    +findByHandle(handle: ProfileHandle): Promise<Identity>
    +hasByExternalIdentifier(externalIdentifier): Promise<boolean>
    +requireByExternalIdentifier(externalIdentifier): Promise<Identity>
    +findCandidateReferencesById(id): Promise<IdentityCandidate[]>
    +findCandidateByExternalIdentifier(id, externalIdentifier): Promise<IdentityCandidate>
    +findCandidateByHandle(handle): Promise<IdentityCandidate>
    +findCandidatesById(id: IdentityId): Promise<Identity[]>
  }

  interface IdentityNetworkRepository {
    +findByIdentityId(identityId: IdentityId): Promise<NetworkId[]>
  }

  interface IdentityAdmissionLoadRepository {
    +countRecent(networkId: NetworkId): Promise<number>
    +record(externalIdentifier, networkIds: NetworkId[]): Promise<void>
  }

  class IdentityAdmissionPricingDomainService {
    +requiredFor(identity, networkIds, now): Promise<IdentityAdmissionDifficulty>
    +charge(externalIdentifier, networkIds): Promise<void>
  }

  class IdentitySaverService {
    +save(identity): Promise<IdentityExternalIdentifier>
  }

  class IdentityFinderService {
    +findById(identityId): Promise<Identity>
    +findByHandle(handle): Promise<Identity>
  }

  note right of Identity
    Identities can join new networks.
    Updates that remove an existing
    network are rejected.
  end note

  Identity *--> Profile
  Identity o--> NetworkId
  Identity --> IdentityExternalIdentifier
  IdentityCandidate --> Identity
  IdentityCandidate --> IdentityExternalIdentifier
  Profile *--> ProfileName
  Profile --> ProfileHandle
  Profile --> ProfileBiography
  Profile --> ProfileImage
  Profile --> ProfileBanner
  Identity ..> IdentitySignatureDomainService
  IdentityResolutionDomainService --> Identity
  IdentitySaverService --> IdentityRepository
  IdentityAdmissionPricingDomainService --> IdentityAdmissionLoadRepository
  IdentityAdmissionPricingDomainService ..> IdentityAdmissionDifficulty
  IdentityFinderService --> IdentityRepository
  IdentityFinderService --> IdentityResolutionDomainService
}

package "identities.application" {
  class IdentityFinder {
    +find(message: IdentityFinderMessage): Promise<Identity>
    +findCandidate(message): Promise<IdentityCandidate>
  }

  class IdentityPublisher {
    +publish(message: IdentityPublishMessage): Promise<Identity>
  }

  class IdentityCandidateRegistrar {
    +register(message: RegisterIdentityCandidateMessage): Promise<void>
  }

  class IdentityNetworksFinder {
    +find(identityId: IdentityId): Promise<NetworkId[]>
  }

  class IdentityAdmissionObserver {
    +observe(message: IdentityAdmissionObservationMessage): Promise<void>
  }

  IdentityPublisher --> IdentitySaverService
  IdentityPublisher --> IdentityRepository
  IdentityPublisher --> IdentityAdmissionPricingDomainService
  IdentityAdmissionObserver --> IdentityAdmissionPricingDomainService
  IdentityFinder --> IdentityFinderService
  IdentityCandidateRegistrar --> IdentityRepository
  IdentityNetworksFinder --> IdentityNetworkRepository
}

package "identities.infrastructure" {
  class IpfsIdentityDocument {
    -_id: string
    -version: number
    -previousExternalIdentifier?: string
    -deviceCredential: string
    -deviceCredentialCommitment: string
    -recoveryAuthority: string
    -authorizationRevision: number
    -networks: string[]
    -profile: object
    -timestamp: number
    -signature: string
  }

  class OrbitDBIdentityMetadataDocument {
    -id: string
    -identityId: string
    -handle?: string
    -cid: string
    -version: number
    -previousCid?: string
    -networkIds: string[]
  }

  class IdentityHandleOwnershipDomainService {
    +rank(candidates, handle): IdentityCandidate[]
    +owner(candidates, handle): IdentityCandidate
  }

  class OrbitDBIdentityMutationGate {
    +governs(collection): boolean
    +accepts(collection, record): Promise<boolean>
    +governsHead(key): boolean
    +acceptsHead(key, record): Promise<boolean>
  }

  interface IdentityMetadataIndex {
    +save(identity, externalIdentifier): Promise<void>
    +findByIdentityId(identityId): Promise<IdentityMetadataRecord[]>
    +findByHandle(handle): Promise<IdentityMetadataRecord[]>
    +findLatestByNetworkId(networkId): Promise<IdentityMetadataRecord[]>
  }

  class OrbitDBIdentityMetadataIndex {
    +save(identity, externalIdentifier): Promise<void>
    +findByIdentityId(identityId): Promise<IdentityMetadataRecord[]>
    +findByHandle(handle): Promise<IdentityMetadataRecord[]>
    +findRetainedVersion(identityId, externalIdentifier): IdentityMetadataRecord
    +verifiedRecordOf(document): Promise<IdentityMetadataRecord>
  }

  class MetadataIdentityNetworkRepository {
    +findByIdentityId(identityId): Promise<NetworkId[]>
  }

  class LocalIdentityAdmissionLoadRepository {
    +countRecent(networkId): Promise<number>
    +record(identityId, networkIds): Promise<void>
  }

  note right of LocalIdentityAdmissionLoadRepository
    Fixed 60 s window in the node's local
    database, keyed by network id only.
    A (network, identityId) sighting is kept
    for twice the freshness horizon, so
    re-signed versions count once per network.
    Stops counting a network at 480 (price
    saturated), prunes once per window and
    drops sightings beyond 1024 pending.
  end note

  class OrbitDBIdentityAdmissionObservationProjection {
    +start(): Promise<void>
  }

  note right of OrbitDBIdentityAdmissionObservationProjection
    Skips stale documents on their signed
    time before any verification; counts
    only canonical-cid records, and only
    into networks this node hosts.
  end note

  class IpfsIdentityRepository {
    +save(identity: Identity): Promise<IdentityExternalIdentifier>
    +findById(id: IdentityId): Promise<Identity>
    +findByHandle(handle: ProfileHandle): Promise<Identity>
    +hasByExternalIdentifier(externalIdentifier): Promise<boolean>
    +requireByExternalIdentifier(externalIdentifier): Promise<Identity>
    +findCandidateByExternalIdentifier(id, externalIdentifier): Promise<IdentityCandidate>
    +findCandidatesById(id: IdentityId): Promise<Identity[]>
  }

  note right of IpfsIdentityRepository
    Encapsulates IPFS documents. The replicated
    metadata index is the canonical read model
    for identity heads.
  end note

  IpfsIdentityRepository ..|> IdentityRepository
  MetadataIdentityNetworkRepository ..|> IdentityNetworkRepository
  LocalIdentityAdmissionLoadRepository ..|> IdentityAdmissionLoadRepository
  OrbitDBIdentityMetadataIndex ..|> IdentityMetadataIndex
  OrbitDBIdentityAdmissionObservationProjection --> OrbitDBIdentityMetadataIndex
  OrbitDBIdentityAdmissionObservationProjection --> IdentityAdmissionObserver
  OrbitDBIdentityMetadataIndex --> IdentityHandleOwnershipDomainService
  IpfsIdentityRepository --> IdentityHandleOwnershipDomainService
  IpfsIdentityRepository --> IpfsIdentityDocument
  IpfsIdentityRepository --> IdentityMetadataIndex
  MetadataIdentityNetworkRepository --> IdentityMetadataIndex
  OrbitDBIdentityMetadataIndex --> OrbitDBIdentityMetadataDocument
}

@enduml
