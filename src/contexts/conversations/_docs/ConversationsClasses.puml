@startuml

title Pigeon Swarm - Conversations Context

package "conversations.domain" {
  abstract class Conversation <<AggregateRoot>> {
    -id: ConversationId
    -networkId: NetworkId
    -type: ConversationType
    -participants: IdentityId[]
    -name?: GroupConversationName
    -admins: ConversationAdmins
    +hasParticipant(identityId: IdentityId): boolean
    +isGroup(): boolean
    +isAdmin(identityId: IdentityId): boolean
    +getAdminIds(): IdentityId[]
    +getCreatorId(): IdentityId | undefined
  }

  class OneToOneConversation
  class GroupConversation

  class ConversationType <<ValueObject>>
  class GroupConversationName <<ValueObject>>
  class ConversationAdmins <<ValueObject>> {
    -creatorId?: IdentityId
    -adminIds: IdentityId[]
  }

  class ConversationDraft {
    -conversationId: ConversationId
    -encryptedPayload: EncryptedMessagePayload
    -updatedAt: Timestamp
  }
  class EncryptedMessagePayload <<ValueObject>>

  class ConversationOperation <<ValueObject>> {
    +id: conversation:<conversationId>:op:<digest>
    +action: ConversationOperationAction
    +parents: string[]
    +isGenesis(): boolean
  }

  class ConversationOperationAction <<Enum>>
  class ConversationOperationApplier
  class ConversationOperationArgumentReader
  class ConversationOperationLimits
  class ConversationRoster {
    +addMember(actor, identityId): void
    +removeMember(actor, identityId): void
    +leave(actor): void
    +promoteAdmin(actor, identityId): void
    +demoteAdmin(actor, identityId): void
  }
  class ConversationStateFold {
    +rosterAfter(operations, candidate): ConversationRoster
  }
  class InvalidConversationOperationError
  class ConversationOperationLimitExceededError

  interface ConversationRepository {
    +hasById(id: ConversationId): Promise<boolean>
    +requireMetadataById(id: ConversationId): Promise<Conversation>
    +requireMetadataAtFrontier(id: ConversationId, frontier: string[]): Promise<Conversation>
    +findByParticipant(participantId: IdentityId, limit: number, beforeConversationId?: ConversationId): Promise<Conversation[]>
    +findFrontier(id: ConversationId): Promise<string[]>
    +findOperations(id: ConversationId): Promise<ConversationOperation[]>
    +saveOperation(operation: ConversationOperation, proof: PublicMutationProof): Promise<void>
  }

  interface ConversationDraftRepository

  note right of ConversationRepository
    Conversations are metadata only. Messages,
    reactions, pins and read state never reach
    the node; they travel through opaque mailboxes.
  end note

  Conversation <|-- OneToOneConversation
  Conversation <|-- GroupConversation
  Conversation --> NetworkId
  Conversation --> ConversationType
  Conversation --> GroupConversationName
  Conversation --> ConversationAdmins
  Conversation o--> IdentityId
  ConversationDraft --> ConversationId
  ConversationDraft --> EncryptedMessagePayload
  ConversationRepository --> Conversation
  ConversationRepository ..> ConversationOperation
  ConversationDraftRepository --> ConversationDraft
  ConversationStateFold ..> ConversationOperation
  ConversationStateFold ..> ConversationOperationApplier
  ConversationOperationApplier --> ConversationRoster
  ConversationOperationApplier ..> ConversationOperationArgumentReader
  ConversationOperation ..> ConversationOperationLimits
  ConversationOperation --> ConversationOperationAction
  ConversationRoster ..> InvalidConversationOperationError
  ConversationOperationLimits ..> ConversationOperationLimitExceededError
}

package "conversations.application" {
  class ConversationCreator {
    +create(message: ConversationCreateMessage): Promise<Conversation>
  }

  class ConversationMemberChanger {
    +change(message: ConversationMemberChangeMessage): Promise<Conversation>
  }

  class ConversationFrontierFinder {
    +find(id: ConversationId, requester: IdentityId): Promise<string[]>
  }

  class ConversationsFinder {
    +find(query): Promise<Conversation[]>
  }

  class ConversationDraftSaver
  class ConversationDraftDeleter
  class ConversationDraftsFinder
  class ConversationDraftAccess

  ConversationCreator --> ConversationRepository
  ConversationMemberChanger --> ConversationRepository
  ConversationFrontierFinder --> ConversationRepository
  ConversationsFinder --> ConversationRepository
  ConversationDraftSaver --> ConversationDraftRepository
  ConversationDraftSaver ..> ConversationDraftAccess
  ConversationDraftDeleter --> ConversationDraftRepository
  ConversationDraftDeleter ..> ConversationDraftAccess
  ConversationDraftsFinder --> ConversationDraftRepository
  ConversationDraftAccess --> ConversationRepository
}

package "conversations.infrastructure" {
  class OrbitDBConversationRepository
  class ConversationOperationMutationPolicy
  class LocalConversationDraftRepository

  note right of OrbitDBConversationRepository
    Folds the Conversation roster from the signed
    conversationOperations store; the participant
    index is local. Writes go through
    ConversationOperationMutationPolicy.
  end note

  OrbitDBConversationRepository ..|> ConversationRepository
  OrbitDBConversationRepository ..> ConversationOperationMutationPolicy
  OrbitDBConversationRepository ..> ConversationStateFold
  LocalConversationDraftRepository ..|> ConversationDraftRepository
}

@enduml
