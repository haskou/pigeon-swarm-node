@startuml

title Pigeon-swarm - Nodes Context

package "nodes" {
  package "domain" {
    class Node <AggregateRoot> {
      -id: NodeId
      -networks: Map<NetworkId, Network>
      -owner?: IdentityId
      -registrationMode: NodeRegistrationMode
      +addNetwork(network: Network, authenticatedIdentityId?: IdentityId): void
      +removeNetwork(networkId: NetworkId, authenticatedIdentityId: IdentityId): void
      +updateRelayConfiguration(relayConfiguration: NodeRelayConfiguration, authenticatedIdentityId?: IdentityId): void
      +assignOwner(owner: IdentityId, authenticatedIdentityId: IdentityId): void
      +hasOwner(): boolean
      +clearNonCanonicalOwner(): boolean
      +isOwnedBy(identityId: IdentityId): boolean
      +assertManagedBy(authenticatedIdentityId: IdentityId): void
      +changeRegistrationMode(mode: NodeRegistrationMode, authenticatedIdentityId: IdentityId): void
      +isOpenForRegistration(): boolean
      +isClosedForRegistration(): boolean
      +toPrimitives(): object
    }

    class NodeRegistrationMode <StringValueObject>

    class NodeRegistrationModeWasChanged <DomainEvent> {
      +eventName(): string
    }

    class NodeRegistrationCode <AggregateRoot> {
      -id: NodeRegistrationCodeId
      -hash: NodeRegistrationCodeHash
      -maxUses: Integer
      -usesLeft: Integer
      -expiresAt: Timestamp
      +{static} issue(secret, maxUses, expiresAt, limits, now): NodeRegistrationCode
      +isUsableAt(now: Timestamp): boolean
      +isExpiredAt(now: Timestamp): boolean
      +reserveUse(now: Timestamp): void
      +releaseUse(): void
      +toPrimitives(): NodeRegistrationCodePrimitives
    }

    class NodeRegistrationCodeSecret
    class NodeRegistrationCodeHash
    class NodeRegistrationCodeId <UUID>
    class NodeRegistrationCodeLimits {
      +maxUses: number
      +maxTtlDays: number
    }

    abstract class NodeRegistrationCodeRepository {
      +save(code: NodeRegistrationCode): Promise<void>
      +findAll(): Promise<NodeRegistrationCode[]>
      +remove(id: NodeRegistrationCodeId): Promise<void>
      +removeExpired(now: Timestamp): Promise<void>
      +reserveUse(hash: NodeRegistrationCodeHash, now: Timestamp): Promise<NodeRegistrationCode | undefined>
      +releaseUse(id: NodeRegistrationCodeId): Promise<void>
    }

    class NodeRegistrationIsClosedError <DomainError>
    class NodeRegistrationCodeIsNotValidError <DomainError>
    class NodeRegistrationCodeMaxUsesIsOutOfRangeError <DomainError>
    class NodeRegistrationCodeExpiryIsOutOfRangeError <DomainError>

    class Network {
      -id: NetworkId
      -name: NetworkName
      -key?: NetworkKey
      +isPublic(): boolean
      +getName(): NetworkName
      +toPrimitives(): object
    }

    class NodeNetworkWasAdded <DomainEvent> {
      +eventName(): string
    }

    class NodeHeartbeatWasSent <DomainEvent> {
      +eventName(): string
    }

    class NodeCommunityStateWasAnnounced <DomainEvent> {
      +eventName(): string
    }

    class NodeCommunityStateDigest <StringValueObject>

    abstract class NodeCommunityStateDigester {
      +digest(networkId: string): Promise<NodeCommunityStateDigest>
    }

    class NodePeer {
      -id: NodeId
      -owner?: IdentityId
      -networks: NodePeerNetwork[]
      -lastSeenAt: Timestamp
      +toPrimitives(): object
    }

    class NodePeerNetwork {
      -id: NetworkId
      -name: NetworkName
      -type: NodePeerNetworkType
      +toPrimitives(): object
    }

    class NodeOwnerCanOnlyBeChangedByCurrentOwnerError <DomainError>
    class InvalidNodeOwnerIdentityIdError <DomainError>

    class NetworkId
    class NetworkName
    class NetworkKey
    class NodePeerNetworkType

    Node o--> "0..N" Network
    Node ..> NodeNetworkWasAdded
    Node *--> NodeRegistrationMode
    Node ..> NodeRegistrationModeWasChanged
    NodeRegistrationCode *--> NodeRegistrationCodeId
    NodeRegistrationCode *--> NodeRegistrationCodeHash
    NodeRegistrationCode ..> NodeRegistrationCodeLimits
    NodeRegistrationCodeSecret ..> NodeRegistrationCodeHash
    NodeRegistrationCodeRepository o--> NodeRegistrationCode
    NodePeer o--> "0..N" NodePeerNetwork
    NodePeer --> NodeId
    NodePeerNetwork *--> NodePeerNetworkType
    Node ..> NodeOwnerCanOnlyBeChangedByCurrentOwnerError
    Node ..> InvalidNodeOwnerIdentityIdError
    Network *--> NetworkId
    Network *--> NetworkName
    Network --> NetworkKey

    class NodeRepository <interface> {
      +loadLocalNode(): Promise<Node>
      +loadLocalNodeRegistrationMode(): Promise<NodeRegistrationMode>
      +updateLocalNode(change: (node: Node) => void): Promise<Node>
      +updateStoppedLocalNode(change: (node: Node) => void): Promise<Node>
      +holdLocalNode<T>(action: (node: Node) => Promise<T>): Promise<T>
    }

    class NodeLoaderService {
      -repository: NodeRepository
      +loadNode(): Promise<Node>
    }

    interface NodePeerRepository {
      +save(peer: NodePeer): Promise<void>
      +findActive(): Promise<NodePeer[]>
    }

    NodeRepository o--> Node
    NodePeerRepository o--> NodePeer
    NodeLoaderService --> NodeRepository

    abstract class NodeBlocks {
      +acceptsReplacement(list: NodeBlockList): boolean
      +blocksIdentity(identityId: IdentityId): boolean
      +toSigned(): SignedNodeBlockList | undefined
    }

    class NodeBlockList {
      -ownerIdentityId: IdentityId
      -version: NodeBlockListVersion
      -blockedIdentityIds: IdentityId[]
      -blockedNodePeerIds: NodePeerId[]
      -identitySignature: Signature
      +{static} fromSigned(signed: SignedNodeBlockList): NodeBlockList
    }

    class SignedNodeBlockList {
      -content: Buffer
      -identitySignature: Signature
      +isSignedBy(identityId: IdentityId): boolean
    }

    note right of SignedNodeBlockList
      Canonical JSON bytes without the signature;
      signed as "pigeon:node-block-list:v1\n" + bytes,
      verified before any byte is parsed.
    end note

    class NoNodeBlocks

    class NodeBlockListRepository <abstract> {
      +findLocal(): Promise<NodeBlocks>
      +saveLocal(list: NodeBlockList): Promise<void>
    }

    class NodeBlockEnforcer <abstract> {
      +enforce(blocks: NodeBlocks, node: Node): Promise<void>
    }

    class NodeBlockEntries {
      -identityIds: IdentityId[]
      -nodePeerIds: NodePeerId[]
      +canonical(): NodeBlockEntries
    }

    class NodeBlockSource {
      -ownerIdentityId: IdentityId
      -origin: NodeBlockSourceOrigin
      -autoApply: boolean
      -list: NodeBlocks
      -approved: NodeBlockEntries
      -lastFetch: NodeBlockSourceFetch
      +receive(signed: SignedNodeBlockList, at: Timestamp): NodeBlockSourceFetchOutcome
      +fetchFailed(outcome: NodeBlockSourceFetchOutcome, at: Timestamp): void
      +approveAll(version: NodeBlockListVersion): void
      +approve(version: NodeBlockListVersion, entries: NodeBlockEntries): void
      +pending(): NodeBlockEntries
      +applied(): NodeBlockEntries
      +dropNonCanonicalApprovals(): number
    }

    note right of NodeBlockSource
      Pinned to the publisher's identity.
      Keeps only a newer list signed by it;
      anything else keeps the last valid one.
      Added entries stay pending unless autoApply;
      removals apply on fetch.
    end note

    abstract class NodeBlockSourceFetch
    class NoNodeBlockSourceFetch
    class RecordedNodeBlockSourceFetch {
      -at: Timestamp
      -outcome: NodeBlockSourceFetchOutcome
    }

    class NodeBlockPublication {
      -published: boolean
    }

    class NodeBlockSourceFetchLimits {
      -interval: Duration
      -maxBytes: number
      -timeout: Duration
    }

    class NodeBlockSourceRepository <abstract> {
      +findAll(): Promise<NodeBlockSource[]>
      +find(ownerIdentityId: IdentityId): Promise<NodeBlockSource>
      +exists(ownerIdentityId: IdentityId): Promise<boolean>
      +save(source: NodeBlockSource): Promise<void>
      +delete(ownerIdentityId: IdentityId): Promise<void>
    }

    class NodeBlockExceptionsRepository <abstract> {
      +find(): Promise<NodeBlockEntries>
      +save(exceptions: NodeBlockEntries): Promise<void>
    }

    class NodeBlockPublicationRepository <abstract> {
      +find(): Promise<NodeBlockPublication>
      +save(publication: NodeBlockPublication): Promise<void>
    }

    class NodeBlockListDownloader <abstract> {
      +download(origin: NodeBlockSourceOrigin): Promise<SignedNodeBlockList>
    }

    class NodeBlockPolicy {
      +load(): Promise<void>
      +reapply(): Promise<void>
      +ownerChanged(node: Node): Promise<void>
      +isIdentityBlocked(identityId: IdentityId): Promise<boolean>
    }

    note right of NodeBlockPolicy
      Caches the effective set in memory:
      own list plus each source's applied entries
      minus local exceptions. An unclaimed node
      blocks nobody; the current owner is never blocked.
      Only canonical identity ids are enforced.
    end note

    NodeBlockList --|> NodeBlocks
    NoNodeBlocks --|> NodeBlocks
    NodeBlockList ..> SignedNodeBlockList
    NodeBlockSource ..> SignedNodeBlockList
    NodeBlockList --> NodePeerId
    NoNodeBlockSourceFetch --|> NodeBlockSourceFetch
    RecordedNodeBlockSourceFetch --|> NodeBlockSourceFetch
    NodeBlockSource --> NodeBlocks
    NodeBlockSource --> NodeBlockEntries
    NodeBlockSource --> NodeBlockSourceFetch
    NodeBlockSourceRepository o--> NodeBlockSource
    NodeBlockPolicy --> NodeBlockListRepository
    NodeBlockPolicy --> NodeBlockSourceRepository
    NodeBlockPolicy --> NodeBlockExceptionsRepository
    NodeBlockPolicy --> NodeBlockEnforcer
  }

  package "application" {
    class NodeNetworkAdder {
      -nodes: NodeRepository
      -eventPublisher: DomainEventPublisher
      +addNetwork(message: NodeNetworkAdderMessage): Promise<void>
    }

    class NodeNetworkRemover {
      -nodes: NodeRepository
      -cleaner: NodeNetworkDataCleaner
      -eventPublisher: DomainEventPublisher
      +remove(message: NodeNetworkRemoverMessage): Promise<void>
    }

    class NodeNetworkAdderMessage {
      +network: Network
      +authenticatedIdentityId?: IdentityId
    }

    class NodeNetworkRemoverMessage {
      +networkId: NetworkId
      +authenticatedIdentityId: IdentityId
      +constructor(networkId: string, authenticatedIdentityId: string)
    }

    class NodeOwnerWriteHolderMessage {
      +authenticatedIdentityId: IdentityId
      +constructor(authenticatedIdentityId: string)
    }

    class NodeOwnerWriteHolder {
      -nodes: NodeRepository
      +hold<T>(message: NodeOwnerWriteHolderMessage, write: () => Promise<T>): Promise<T>
    }

    note right of NodeOwnerWriteHolder
      Checks the owner of the latest node and runs
      an owner-only write stored elsewhere before
      any handover can land.
    end note

    interface NodeNetworkDataCleaner {
      +clean(networkId: NetworkId): Promise<void>
    }

    class NodeOwnerAssignerMessage {
      +owner: IdentityId
      +authenticatedIdentityId: IdentityId
      +constructor(owner: string, authenticatedIdentityId: string)
    }

    class NodeLoader {
      -nodeLoaderService: NodeLoaderService
      +loadNode(): Promise<Node>
    }

    class NodeOwnerAssigner {
      -nodes: NodeRepository
      -blockPolicy: NodeBlockPolicy
      +assignOwner(message: NodeOwnerAssignerMessage): Promise<void>
    }

    class NodeHeartbeatSender {
      +send(): Promise<void>
    }

    class NodePeerRegistrar {
      +register(message: NodePeerRegisterMessage): Promise<void>
    }

    class NodePeersFinder {
      +find(): Promise<ActiveNodePeers>
    }

    class ActiveNodePeers {
      +getLocalNode(): Node
      +getPeers(): NodePeer[]
    }

    class NodeNetworkSynchronizationFinder {
      +find(): NodeNetworkSynchronizationStatus
    }

    abstract class NodeNetworkSynchronizationMonitor

    class NodeCommunityStateAnnouncer {
      +announce(): Promise<void>
    }

    class NodePeerCommunityStateRecorder {
      +record(message: NodePeerCommunityStateRecordMessage): void
    }

    class NodeRegistrationModeChanger {
      +change(message: NodeRegistrationModeChangerMessage): Promise<Node>
    }

    class NodeRegistrationCodeIssuer {
      +issue(message: NodeRegistrationCodeIssuerMessage): Promise<IssuedNodeRegistrationCode>
    }

    class NodeRegistrationCodesFinder {
      +find(): Promise<NodeRegistrationCode[]>
    }

    class NodeRegistrationCodeRevoker {
      +revoke(message: NodeRegistrationCodeRevokerMessage): Promise<void>
    }

    class NodeRegistrationAdmitter {
      +admit(message: NodeRegistrationAdmitterMessage): Promise<NodeRegistrationReservation>
      +release(reservation: NodeRegistrationReservation): Promise<void>
    }

    note right of NodeRegistrationAdmitter
      Gates identity creation through this node:
      open admits, closed refuses, codes reserves
      one use atomically; release returns it.
    end note

    NodeNetworkAdder --> NodeRepository
    NodeNetworkAdder --> NodeNetworkAdderMessage
    NodeNetworkRemover --> NodeRepository
    NodeNetworkRemover --> NodeNetworkDataCleaner
    NodeNetworkRemover --> NodeNetworkRemoverMessage
    NodeLoader --> NodeLoaderService
    NodeOwnerAssigner --> NodeRepository
    NodeOwnerAssigner --> NodeBlockPolicy
    NodeOwnerAssigner --> NodeOwnerAssignerMessage
    NodeOwnerWriteHolder --> NodeRepository
    NodeOwnerWriteHolder --> NodeOwnerWriteHolderMessage
    NodeHeartbeatSender --> NodeLoaderService
    NodeHeartbeatSender ..> NodeHeartbeatWasSent
    NodePeerRegistrar --> NodePeerRepository
    NodePeersFinder --> NodePeerRepository
    NodePeersFinder --> NodeRepository
    NodeNetworkSynchronizationFinder --> NodeNetworkSynchronizationMonitor
    NodeCommunityStateAnnouncer --> NodeNetworkSynchronizationMonitor
    NodeCommunityStateAnnouncer --> NodeCommunityStateDigester
    NodeCommunityStateAnnouncer ..> NodeCommunityStateWasAnnounced
    NodePeerCommunityStateRecorder --> NodeNetworkSynchronizationMonitor
    NodeRegistrationModeChanger --> NodeRepository
    NodeRegistrationCodeIssuer --> NodeRegistrationCodeRepository
    NodeRegistrationCodesFinder --> NodeRegistrationCodeRepository
    NodeRegistrationCodeRevoker --> NodeRegistrationCodeRepository
    NodeRegistrationAdmitter --> NodeRepository
    NodeRegistrationAdmitter --> NodeRegistrationCodeRepository

    class NodeBlockListStorer {
      +store(message: NodeBlockListStorerMessage): Promise<NodeBlockList>
    }

    class NodeBlockListFinder {
      +find(): Promise<NodeBlocks>
    }

    NodeBlockListStorer --> NodeRepository
    NodeBlockListStorer --> NodeBlockListRepository
    NodeBlockListStorer --> NodeBlockPolicy
    NodeBlockListStorer --> NodeRepository
    NodeBlockListFinder --> NodeBlockListRepository

    class NodeBlockSourceAdopter {
      +adopt(message: NodeBlockSourceAdopterMessage): Promise<NodeBlockSource>
    }

    class NodeBlockSourceRemover {
      +remove(message: NodeBlockSourceRemoverMessage): Promise<void>
    }

    class NodeBlockSourceEntriesApprover {
      +approve(message: NodeBlockSourceEntriesApproverMessage): Promise<NodeBlockSource>
    }

    class NodeBlockSourcesRefresher {
      +refresh(now: Timestamp): Promise<void>
    }

    class NodeBlockSourcesFinder {
      +find(): Promise<NodeBlockSource[]>
    }

    class NodeBlockSourceFinder {
      +find(message: NodeBlockSourceFinderMessage): Promise<NodeBlockSource>
    }

    class NodeBlockExceptionsUpdater {
      +update(message: NodeBlockExceptionsUpdaterMessage): Promise<NodeBlockEntries>
    }

    class NodeBlockExceptionsFinder {
      +find(): Promise<NodeBlockEntries>
    }

    class NonCanonicalIdentityIdsPurger {
      +purge(): Promise<NonCanonicalIdentityIdsPurge>
    }

    class NodeBlockListPublicationUpdater {
      +update(message: NodeBlockListPublicationUpdaterMessage): Promise<NodeBlockPublication>
    }

    class NodeBlockListPublicationFinder {
      +find(): Promise<NodeBlockPublication>
    }

    class PublishedNodeBlockListFinder {
      +find(): Promise<NodeBlocks>
    }

    NodeBlockSourceAdopter --> NodeBlockSourceRepository
    NodeBlockSourceAdopter --> NodeBlockPolicy
    NodeBlockSourceAdopter --> NodeOwnerWriteHolder
    NodeBlockSourceRemover --> NodeBlockSourceRepository
    NodeBlockSourceRemover --> NodeBlockPolicy
    NodeBlockSourceRemover --> NodeOwnerWriteHolder
    NodeBlockSourceEntriesApprover --> NodeBlockSourceRepository
    NodeBlockSourceEntriesApprover --> NodeBlockPolicy
    NodeBlockSourceEntriesApprover --> NodeOwnerWriteHolder
    NodeBlockSourcesRefresher --> NodeBlockSourceRepository
    NodeBlockSourcesRefresher --> NodeBlockListDownloader
    NodeBlockSourcesRefresher --> NodeBlockSourceFetchLimits
    NodeBlockSourcesRefresher --> NodeBlockPolicy
    NodeBlockSourcesRefresher --> NodeRepository
    NodeBlockSourcesFinder --> NodeBlockSourceRepository
    NodeBlockSourceFinder --> NodeBlockSourceRepository
    NodeBlockExceptionsUpdater --> NodeBlockExceptionsRepository
    NodeBlockExceptionsUpdater --> NodeBlockPolicy
    NodeBlockExceptionsUpdater --> NodeOwnerWriteHolder
    NonCanonicalIdentityIdsPurger --> NodeRepository
    NonCanonicalIdentityIdsPurger --> NodeBlockExceptionsRepository
    NonCanonicalIdentityIdsPurger --> NodeBlockSourceRepository
    NodeBlockExceptionsFinder --> NodeBlockExceptionsRepository
    NodeBlockListPublicationUpdater --> NodeBlockPublicationRepository
    NodeBlockListPublicationFinder --> NodeBlockPublicationRepository
    PublishedNodeBlockListFinder --> NodeBlockPublicationRepository
    PublishedNodeBlockListFinder --> NodeBlockListRepository
    PublishedNodeBlockListFinder ..> NodeBlocks
  }

  package "infrastructure" {
    class LocalNodeMetadataRepository {
      -networkRegistry: IPFSNetworkRegistry
      +loadLocalNode(): Promise<Node>
      +loadLocalNodeRegistrationMode(): Promise<NodeRegistrationMode>
      +updateLocalNode(change: (node: Node) => void): Promise<Node>
      +updateStoppedLocalNode(change: (node: Node) => void): Promise<Node>
      +holdLocalNode<T>(action: (node: Node) => Promise<T>): Promise<T>
    }

    class LocalNodeRegistrationCodeRepository {
      +reserveUse(hash: NodeRegistrationCodeHash, now: Timestamp): Promise<NodeRegistrationCode | undefined>
    }

    note right of LocalNodeRegistrationCodeRepository
      Local-only collection of code hashes and uses left.
      A serial queue makes reserve and release atomic.
    end note

    class LocalNodePeerRepository {
      +save(peer: NodePeer): Promise<void>
      +findActive(): Promise<NodePeer[]>
    }

    class InMemoryNodeNetworkSynchronizationMonitor

    class CommunityRepositoryNodeCommunityStateDigester {
      -communityRepository: CommunityRepository
    }

    note right of CommunityRepositoryNodeCommunityStateDigester
      Hashes every community frontier of a network.
      Equal digests mean equal community state;
      the digest is never exposed to clients.
    end note

    note right of LocalNodeMetadataRepository
      Active node metadata repository.
      Local embedded storage owns nodeId, owner and
      configured network metadata.
      Loading and saving synchronizes
      the runtime IPFSNetworkRegistry.
    end note

    LocalNodeMetadataRepository ..|> NodeRepository
    LocalNodePeerRepository ..|> NodePeerRepository
    LocalNodeRegistrationCodeRepository ..|> NodeRegistrationCodeRepository
    InMemoryNodeNetworkSynchronizationMonitor ..|> NodeNetworkSynchronizationMonitor
    CommunityRepositoryNodeCommunityStateDigester ..|> NodeCommunityStateDigester
    class LocalNodeBlockListRepository
    class LocalNodeBlockSourceRepository
    class LocalNodeBlockExceptionsRepository
    class LocalNodeBlockPublicationRepository
    class HttpNodeBlockListDownloader
    class RuntimeNodeBlockEnforcer

    note right of HttpNodeBlockListDownloader
      Public HTTPS only, through PublicHttpGetter:
      no redirects, streamed byte limit, one deadline.
    end note

    note right of RuntimeNodeBlockEnforcer
      Closes blocked identities' sockets and
      disconnects and gates blocked node peers.
    end note

    LocalNodeBlockListRepository ..|> NodeBlockListRepository
    LocalNodeBlockSourceRepository ..|> NodeBlockSourceRepository
    LocalNodeBlockExceptionsRepository ..|> NodeBlockExceptionsRepository
    LocalNodeBlockPublicationRepository ..|> NodeBlockPublicationRepository
    HttpNodeBlockListDownloader ..|> NodeBlockListDownloader
    RuntimeNodeBlockEnforcer ..|> NodeBlockEnforcer
  }
}

@enduml
