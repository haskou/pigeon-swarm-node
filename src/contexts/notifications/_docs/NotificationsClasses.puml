@startuml

title Pigeon-swarm - Notifications Context

package "notifications" {
  package "domain" {
    class Notification <AggregateRoot> {
      -id: NotificationId
      -type: NotificationType
      -recipientIdentityId: IdentityId
      -status: NotificationStatus
      -state: NotificationState
      -payload: ConversationInvitationPayload | GroupConversationInvitationPayload | CommunityInvitationPayload | MissedCallPayload
      +accept(): void
      +decline(): void
      +isRecipient(identityId: IdentityId): boolean
      +toPrimitives(): object
    }

    note right of Notification
      status: unread | read
      state: pending | accepted | declined
      Invitations are replicated as records signed by
      the inviter; state changes are signed by the
      recipient. Missed call notifications are created
      by the call timeout scheduler, stay local and
      are never replicated.
    end note

    class ConversationInvitationPayload {
      -conversationId: ConversationId
      -inviterIdentityId: IdentityId
      -recipientIdentityId: IdentityId
      -encryptedConversationKey: EncryptedConversationKey
      -nonce: InvitationNonce
      +toPrimitives(): object
    }

    class GroupConversationInvitationPayload {
      -inviterIdentityId: IdentityId
      -recipientIdentityId: IdentityId
      -encryptedConversationKey: EncryptedConversationKey
      -nonce: InvitationNonce
      +toPrimitives(): object
    }

    note right of GroupConversationInvitationPayload
      Names no conversation: the conversation id
      travels only inside the seal, and the node
      checks no group roster (D15).
    end note

    class CommunityInvitationPayload {
      -communityId: CommunityId
      -inviterIdentityId: IdentityId
      -recipientIdentityId: IdentityId
      -nonce: InvitationNonce
      +toPrimitives(): object
    }

    class MissedCallPayload {
      -callId: MissedCallId
      -callerIdentityId: IdentityId
      -networkId: NetworkId
      -recipientIdentityId: IdentityId
      +toPrimitives(): object
    }

    note right of ConversationInvitationPayload
      Encrypted conversation key is opaque.
      Backend never decrypts private keys
      or conversation keys.
    end note

    class NotificationRepository <interface> {
      +hasById(notificationId: NotificationId): Promise<boolean>
      +requireById(notificationId: NotificationId): Promise<Notification>
      +findByRecipient(recipientIdentityId: IdentityId): Promise<Notification[]>
      +saveInvitation(notification: Notification, proof: PublicMutationProof): Promise<void>
      +saveState(notification: Notification, proof: PublicMutationProof): Promise<void>
      +saveMissedCall(notification: Notification): Promise<void>
    }

    class PendingGroupInvitationLimits {
      +perPair: number
      +perRecipient: number
    }

    class PendingGroupInvitationCaps {
      -limits: PendingGroupInvitationLimits
      +listed(notifications: Notification[]): Notification[]
    }
    note right of PendingGroupInvitationCaps
      Pending group invitations in ascending record id order:
      at most perPair per (inviter, recipient), then perRecipient
      per recipient. The rest is held back from the listing, not deleted.
    end note

    Notification *--> ConversationInvitationPayload
    Notification *--> GroupConversationInvitationPayload
    Notification *--> CommunityInvitationPayload
    Notification *--> MissedCallPayload
    PendingGroupInvitationCaps --> PendingGroupInvitationLimits
    NotificationRepository o--> Notification
  }

  package "application" {
    class NotificationCreator {
      -repository: NotificationRepository
      +create(message: NotificationCreateMessage): Promise<Notification>
    }

    class NotificationsFinder {
      -repository: NotificationRepository
      -caps: PendingGroupInvitationCaps
      +find(message: NotificationsFindMessage): Promise<Notification[]>
    }

    class NotificationUpdater {
      -repository: NotificationRepository
      +update(message: NotificationUpdateMessage): Promise<Notification>
    }

    NotificationCreator --> NotificationRepository
    NotificationsFinder --> NotificationRepository
    NotificationsFinder --> PendingGroupInvitationCaps
    NotificationUpdater --> NotificationRepository
  }

  package "infrastructure" {
    class OrbitDBNotificationRepository {
      +saveInvitation(notification: Notification, proof: PublicMutationProof): Promise<void>
      +saveState(notification: Notification, proof: PublicMutationProof): Promise<void>
    }

    class LocalNotificationRepository {
      +saveMissedCall(notification: Notification): Promise<void>
    }

    class NotificationRepositoryRouter {
      +hasById(notificationId: NotificationId): Promise<boolean>
      +requireById(notificationId: NotificationId): Promise<Notification>
      +findByRecipient(recipientIdentityId: IdentityId): Promise<Notification[]>
    }

    class NotificationInvitationMutationPolicy
    class NotificationStateMutationPolicy
    class OrbitDBNotificationHeadMutationGate
    class GenuineRecordQuota {
      +assertWithin(record, rule): Promise<void>
    }

    NotificationRepositoryRouter ..|> NotificationRepository
    NotificationRepositoryRouter --> OrbitDBNotificationRepository
    NotificationRepositoryRouter --> LocalNotificationRepository
    NotificationInvitationMutationPolicy --> GenuineRecordQuota
    NotificationStateMutationPolicy --> GenuineRecordQuota
  }
}

@enduml
